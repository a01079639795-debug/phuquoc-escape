# ── База данных ──────────────────────────────────────────────────────────────
# Локально поднимается через docker-compose.yml
DATABASE_URL="postgresql://phuquoc:phuquoc@localhost:5432/phuquoc?schema=public"

# ── Объектное хранилище (S3-совместимое) ─────────────────────────────────────
# Прод: Cloudflare R2. Локально: MinIO — тот же протокол, отличается endpoint.
# Если переменные не заданы, приложение вне продакшена использует хранилище
# в памяти процесса и пишет об этом предупреждение; в продакшене — падает
# при старте, чтобы загрузка не притворялась работающей.
S3_BUCKET="phuquoc-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# Для MinIO укажите адрес и path-style; для R2 endpoint вида
# https://<account>.r2.cloudflarestorage.com, path-style не нужен.
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"
# Домен раздачи через CDN — на него ссылаются записи медиатеки.
S3_PUBLIC_URL="http://localhost:9000/phuquoc-media"

# ── Уведомления ──────────────────────────────────────────────────────────────
# Telegram — единственный канал на этом этапе. Без этих переменных сообщения
# пишутся в лог вместо отправки.
# Внимание: сообщение содержит контакты клиента, поэтому чат должен быть
# закрытым, а состав участников — контролируемым.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MANAGER_CHAT_ID=""

# ── Приложение ───────────────────────────────────────────────────────────────
# APP_URL="http://localhost:3000"

# ── Почта (следующий этап, сейчас не используется) ───────────────────────────
# RESEND_API_KEY=""
# MAIL_FROM="noreply@example.com"
