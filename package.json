{
  "name": "phuquoc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Платформа Фукуок — модульный монолит (Next.js + Prisma + PostgreSQL)",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:verify": "node prisma/verify-schema.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify:race": "node prisma/verify-cover-concurrency.mjs",
    "db:verify:seed": "node prisma/verify-seed.mjs",
    "db:verify:all": "npm run db:verify && npm run db:verify:race && npm run db:verify:seed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/server/service.test.ts",
    "verify:all": "npm run typecheck && npm run db:verify:all && npm run test:all",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:http": "node --import tsx --test src/server/http/transport.test.ts",
    "test:all": "npm test && npm run test:http && npm run test:media && npm run test:notify",
    "test:media": "node --import tsx --test src/server/storage/media.test.ts",
    "test:notify": "node --import tsx --test src/server/notifications/notifications.test.ts",
    "dev:db": "node scripts/dev-db.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.16.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.16.2",
    "@tailwindcss/postcss": "^4.3.3",
    "image-size": "^2.0.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  }
}
